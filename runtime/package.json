{
  "name": "@cppsocial/feedback-runtime",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "dist/package"
  ],
  "main": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js"
    },
    "./oauth/callback.html": "./dist/package/oauth/callback.html",
    "./oauth/callback.js": "./dist/package/oauth/callback.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json && node scripts/verify-build.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "node --import=./scripts/register-graphql.mjs --import=tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "tsx": "4.20.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
