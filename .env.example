# Name of a locally built and loaded production image.
FEEDBACK_IMAGE=ghcr.io/cppsocial/feedback@sha256:replace-with-release-digest

FEEDBACK_HOST_PORT=18080
FEEDBACK_CONFIG_FILE=/etc/cppsocial-feedback/sites.toml
FEEDBACK_DATA_DIRECTORY=/var/lib/cppsocial-feedback

# These must be regular files, owned by the deployment operator and mode 0400.
FEEDBACK_GITHUB_APP_PRIVATE_KEY_FILE=/run/keys/cppsocial-feedback/github-app-private-key.pem
FEEDBACK_GITHUB_CLIENT_SECRET_FILE=/run/keys/cppsocial-feedback/github-client-secret
FEEDBACK_OAUTH_STATE_HMAC_KEY_FILE=/run/keys/cppsocial-feedback/oauth-state-hmac-key

# Address from which the reverse proxy reaches the container.
FEEDBACK_FORWARDED_ALLOW_IPS=172.17.0.1
FEEDBACK_LIMIT_CONCURRENCY=64
FEEDBACK_KEEP_ALIVE_SECONDS=5
